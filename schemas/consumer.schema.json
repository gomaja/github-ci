{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gomaja/github-ci/schemas/consumer.schema.json",
  "title": "github-ci consumer configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "profile"],
  "properties": {
    "schema-version": { "const": 2 },
    "profile": { "enum": ["go-strict", "go-library", "repository-only"] },
    "go": { "$ref": "#/$defs/go" },
    "generated-paths": { "$ref": "#/$defs/paths" },
    "exceptions": { "$ref": "#/$defs/path" }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "repository-only" } }, "required": ["profile"] },
      "then": { "not": { "required": ["go"] } }
    }
  ],
  "$defs": {
    "go": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": { "$ref": "#/$defs/go-settings" },
        "modules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/go-module" }
        }
      }
    },
    "go-settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": { "$ref": "#/$defs/packages" },
        "module-mode": { "enum": ["readonly", "vendor", "mod"] },
        "build-tags": { "$ref": "#/$defs/build-tags" },
        "test-timeout": { "type": "string", "pattern": "^(?:(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|1[0-9]{3}|2[0-6][0-9]{2}|2700)s|(?:[1-9]|[1-3][0-9]|4[0-5])m)$" },
        "package-parallelism": { "type": "integer", "minimum": 1, "maximum": 64 },
        "race-parallelism": { "type": "integer", "minimum": 1, "maximum": 16 },
        "coverage-packages": { "$ref": "#/$defs/coverage-packages" }
      }
    },
    "go-module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "packages": { "$ref": "#/$defs/packages" },
        "module-mode": { "enum": ["readonly", "vendor", "mod"] },
        "build-tags": { "$ref": "#/$defs/build-tags" },
        "test-timeout": { "type": "string", "pattern": "^(?:(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|1[0-9]{3}|2[0-6][0-9]{2}|2700)s|(?:[1-9]|[1-3][0-9]|4[0-5])m)$" },
        "package-parallelism": { "type": "integer", "minimum": 1, "maximum": 64 },
        "race-parallelism": { "type": "integer", "minimum": 1, "maximum": 16 },
        "coverage-packages": { "$ref": "#/$defs/coverage-packages" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/package" }
    },
    "coverage-packages": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/package" }
    },
    "package": {
      "type": "string",
      "pattern": "^(?:\\.|[A-Za-z0-9_][A-Za-z0-9_.-]*)(?:/(?:\\.\\.\\.|[A-Za-z0-9_][A-Za-z0-9_.-]*))*$"
    },
    "build-tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.]+$" }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|[A-Za-z0-9_][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:\\.|[A-Za-z0-9_][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
    },
    "paths": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  }
}

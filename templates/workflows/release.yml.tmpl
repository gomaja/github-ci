# Code generated from templates/workflows/release.yml.tmpl; DO NOT EDIT.
name: reusable-release

on:
  workflow_call:
    inputs:
      acceptance-required:
        required: false
        default: false
        type: boolean
      go-version:
        required: false
        default: "[%.Policy.GoVersions.Current%]"
        type: string
      include-callers:
        required: false
        default: false
        type: boolean
      tag:
        required: false
        default: ""
        type: string

permissions:
  contents: read

jobs:
  release-evidence:
    name: release evidence
    permissions:
      actions: read  # Self-release acceptance is downloaded from this workflow run.
      id-token: write  # Provenance attestation requires an OIDC identity.
      attestations: write  # The action records provenance without publishing a release.
      contents: read
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
            sigstore-tuf-root.storage.googleapis.com:443
            fulcio.sigstore.dev:443
            rekor.sigstore.dev:443
      - name: Check out consumer
        uses: [%.Action "checkout"%]
        with:
          fetch-depth: 0
          persist-credentials: false
          path: source
          ref: ${{ inputs.tag || github.ref }}
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: ${{ job.workflow_repository }}
          ref: ${{ job.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap policy CLI
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ inputs.go-version }}
          install-tools: "false"
      - name: Download verified release acceptance
        if: ${{ inputs.acceptance-required }}
        uses: [%.Action "download-artifact"%]
        with:
          name: github-ci-release-acceptance
          path: ${{ runner.temp }}/github-ci-release-acceptance
      - name: Install SBOM generators
        env:
          BIN_DIR: ${{ runner.temp }}/github-ci-bin
          CENTRAL_DIR: ${{ github.workspace }}/github-ci
        shell: bash
        run: bash "$CENTRAL_DIR/scripts/install-scanners.sh" supply-chain
      - name: Validate tag and build deterministic evidence
        env:
          ACCEPTANCE_RECORD: ${{ runner.temp }}/github-ci-release-acceptance/acceptance.json
          ACCEPTANCE_REQUIRED: ${{ inputs.acceptance-required }}
          CENTRAL_DIR: ${{ github.workspace }}/github-ci
          CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          EVENT_SHA: ${{ github.sha }}
          GOVERNANCE_CLI: ${{ runner.temp }}/github-ci-bin/github-ci-govern
          INCLUDE_CALLERS: ${{ inputs.include-callers }}
          REF_NAME: ${{ github.ref_name }}
          REF_TYPE: ${{ github.ref_type }}
          REPOSITORY: ${{ github.repository }}
          REQUESTED_TAG: ${{ inputs.tag }}
          SOURCE_DIR: ${{ github.workspace }}/source
          WORKFLOW_REPOSITORY: ${{ job.workflow_repository }}
        shell: bash
        run: |
          set -euo pipefail
          export PATH="$RUNNER_TEMP/github-ci-bin:$PATH"
          tag="$REQUESTED_TAG"
          [[ -n "$tag" ]] || tag="$REF_NAME"
          [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]
          tagged_sha=$(git -C "$SOURCE_DIR" rev-parse "refs/tags/$tag^{commit}")
          source_sha=$(git -C "$SOURCE_DIR" rev-parse HEAD)
          [[ "$source_sha" == "$tagged_sha" ]]
          if [[ "$REF_TYPE" == "tag" ]]; then
            [[ "$tagged_sha" == "$EVENT_SHA" ]]
          fi
          mkdir -p "$SOURCE_DIR/dist"
          git -C "$SOURCE_DIR" archive --format=tar.gz --prefix="${GITHUB_REPOSITORY##*/}-$tag/" -o "$SOURCE_DIR/dist/source-$tag.tar.gz" "$tag"
          acceptance_args=()
          if [[ "$ACCEPTANCE_REQUIRED" == "true" ]]; then
            [[ "$REPOSITORY" == "$WORKFLOW_REPOSITORY" ]]
            [[ -f "$ACCEPTANCE_RECORD" ]]
            "$CLI" verify-acceptance-record --record "$ACCEPTANCE_RECORD" --expected-sha "$tagged_sha"
            cp "$ACCEPTANCE_RECORD" "$SOURCE_DIR/dist/release-acceptance.json"
            acceptance_args=(--asset dist/release-acceptance.json)
          fi
          caller_args=()
          if [[ "$INCLUDE_CALLERS" == "true" ]]; then
            [[ "$REPOSITORY" == "$WORKFLOW_REPOSITORY" ]]
            (cd "$SOURCE_DIR" && go build -trimpath -o "$GOVERNANCE_CLI" ./cmd/github-ci-govern)
            caller_output="$RUNNER_TEMP/release-callers"
            "$GOVERNANCE_CLI" render-callers \
              --manifest "$SOURCE_DIR/governance/gomaja.yaml" \
              --repository github-ci \
              --workflow-sha "$tagged_sha" \
              --output "$caller_output"
            caller_root="$caller_output/gomaja/github-ci/.github"
            cp "$caller_root/github-ci.yaml" "$SOURCE_DIR/dist/github-ci.yaml"
            cp "$caller_root/workflows/github-ci.yml" "$SOURCE_DIR/dist/github-ci.yml"
            cp "$caller_root/workflows/github-ci-deep.yml" "$SOURCE_DIR/dist/github-ci-deep.yml"
            cp "$caller_root/workflows/github-ci-release.yml" "$SOURCE_DIR/dist/github-ci-release.yml"
            caller_args=(
              --asset dist/github-ci.yaml
              --asset dist/github-ci.yml
              --asset dist/github-ci-deep.yml
              --asset dist/github-ci-release.yml
            )
          fi
          syft "dir:$SOURCE_DIR" --quiet --output "spdx-json=$SOURCE_DIR/dist/sbom.spdx.json" --output "cyclonedx-json=$SOURCE_DIR/dist/sbom.cdx.json"
          source_date=$(git -C "$SOURCE_DIR" show -s --format=%cI "$tagged_sha")
          "$CLI" release-evidence --root "$SOURCE_DIR" --subject-sha "$tagged_sha" --source-date "$source_date" \
            --asset "dist/source-$tag.tar.gz" \
            --asset dist/sbom.spdx.json \
            --asset dist/sbom.cdx.json \
            "${acceptance_args[@]}" \
            "${caller_args[@]}" \
            --manifest "$SOURCE_DIR/dist/release-manifest.json" --checksums "$SOURCE_DIR/dist/SHA256SUMS"
          "$CLI" verify-release-evidence --root "$SOURCE_DIR" --manifest "$SOURCE_DIR/dist/release-manifest.json" --checksums "$SOURCE_DIR/dist/SHA256SUMS"
      - name: Attest release evidence
        uses: [%.Action "attest-build-provenance"%]
        with:
          subject-path: source/dist/*
      - name: Upload release evidence
        uses: [%.Action "upload-artifact"%]
        with:
          name: github-ci-release-evidence
          path: source/dist
          if-no-files-found: error
          retention-days: 30

  gate:
    name: gate
    if: ${{ always() }}
    needs: [release-evidence]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Require release evidence
        env:
          RESULT: ${{ needs.release-evidence.result }}
        shell: bash
        run: test "$RESULT" = success

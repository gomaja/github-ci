# Code generated from templates/workflows/release.yml.tmpl; DO NOT EDIT.
name: reusable-release

on:
  workflow_call:
    inputs:
      go-version:
        required: false
        default: "[%.Policy.GoVersions.Current%]"
        type: string

permissions:
  contents: read

jobs:
  release-policy:
    name: release policy
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: audit
      - name: Check out consumer
        uses: [%.Action "checkout"%]
        with:
          persist-credentials: false
      - name: Set up Go
        uses: [%.Action "setup-go"%]
        with:
          go-version: ${{ inputs.go-version }}
          cache: false
      - name: Validate clean release source
        shell: bash
        run: test -z "$(git status --porcelain=v1)"

  gate:
    name: gate
    if: ${{ always() }}
    needs: [release-policy]
    runs-on: ubuntu-latest
    steps:
      - name: Require release policy
        env:
          RESULT: ${{ needs.release-policy.result }}
        shell: bash
        run: test "$RESULT" = success

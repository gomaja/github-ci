        shell: bash
        run: bash "$CENTRAL_DIR/scripts/install-scanners.sh" security
      - name: Run gitleaks/content, osv-scanner/dependencies, trivy/filesystem, semgrep/source
        env:
          BIN_DIR: ${{ runner.temp }}/github-ci-bin
          CENTRAL_DIR: ${{ github.workspace }}/github-ci

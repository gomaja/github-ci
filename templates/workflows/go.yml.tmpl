          path: source
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: gomaja/github-ci
          ref: ${{ github.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap analyzers
        id: bootstrap
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ inputs.go-version }}
      - name: Download applicability plan
        uses: [%.Action "download-artifact"%]
        with:
          name: github-ci-plan
          path: ${{ runner.temp }}/github-ci-plan
      - name: Run formatting analyzers
        env:
          CENTRAL_DIR: ${{ github.workspace }}/github-ci
          CONFIG_PATH: ${{ inputs.config-path }}
          GITHUB_CI_CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          OUTPUT_DIR: ${{ runner.temp }}/github-ci-evidence
          PLAN_PATH: ${{ runner.temp }}/github-ci-plan/plan.json
          SOURCE_DIR: ${{ github.workspace }}/source
        shell: bash
        run: bash "$CENTRAL_DIR/scripts/run-go-group.sh" formatting
      - name: Upload formatting evidence
        if: ${{ always() }}
        uses: [%.Action "upload-artifact"%]
        with:
          name: github-ci-go-formatting-evidence
          path: ${{ runner.temp }}/github-ci-evidence

  scorecard:
    name: OpenSSF Scorecard
    needs: preflight
    permissions:
      contents: read
      security-events: read  # Scorecard reads security metadata without publishing.
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
            api.deps.dev:443
            api.osv.dev:443
            oss-fuzz-build-logs.storage.googleapis.com:443
            www.bestpractices.dev:443
      - name: Check out consumer
        uses: [%.Action "checkout"%]

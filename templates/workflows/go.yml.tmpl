  analysis:
    name: static analysis
    needs: preflight
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            vuln.go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
            files.pythonhosted.org:443
            pypi.org:443
            auth.docker.io:443
            registry-1.docker.io:443
            production.cloudfront.docker.com:443
            ghcr.io:443
            pkg-containers.githubusercontent.com:443
            api.osv.dev:443
            osv-vulnerabilities.storage.googleapis.com:443
            mirror.gcr.io:443
            toolbox-data.anchore.io:443
            grype.anchore.io:443
      - name: Check out consumer
        uses: [%.Action "checkout"%]
        with:
          persist-credentials: false
          path: source
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: gomaja/github-ci
          ref: ${{ github.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap analyzers
        id: bootstrap
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ inputs.go-version }}
      - name: Download applicability plan
        uses: [%.Action "download-artifact"%]
        with:
          name: github-ci-plan
          path: ${{ runner.temp }}/github-ci-plan
      - name: Run static analyzers
        env:
          CENTRAL_DIR: ${{ github.workspace }}/github-ci
          CONFIG_PATH: ${{ inputs.config-path }}
          GITHUB_CI_CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          OUTPUT_DIR: ${{ runner.temp }}/github-ci-evidence
          PLAN_PATH: ${{ runner.temp }}/github-ci-plan/plan.json
          SOURCE_DIR: ${{ github.workspace }}/source
        shell: bash
        run: bash "$CENTRAL_DIR/scripts/run-go-group.sh" analysis
      - name: Upload static-analysis evidence
        if: ${{ always() }}
        uses: [%.Action "upload-artifact"%]
        with:
          name: github-ci-go-analysis-evidence
          path: ${{ runner.temp }}/github-ci-evidence
          if-no-files-found: error
          retention-days: 7

  compatibility:
    name: Go ${{ matrix.go-version }}
    needs: preflight
    strategy:
      fail-fast: false
      matrix:
        go-version: ["${{ inputs.go-version }}", "${{ inputs.previous-go-version }}"]
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
            files.pythonhosted.org:443
            pypi.org:443
            auth.docker.io:443
            registry-1.docker.io:443
            production.cloudfront.docker.com:443
            ghcr.io:443
            pkg-containers.githubusercontent.com:443
            api.osv.dev:443
            osv-vulnerabilities.storage.googleapis.com:443
            mirror.gcr.io:443
            toolbox-data.anchore.io:443
            grype.anchore.io:443
      - name: Check out consumer
        uses: [%.Action "checkout"%]
        with:
          persist-credentials: false
          path: source
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: gomaja/github-ci
          ref: ${{ github.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap compatibility toolchain
        id: bootstrap
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ matrix.go-version }}
          install-tools: "false"
      - name: Build and test every module
        env:
          CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          CONFIG_PATH: ${{ inputs.config-path }}
          SOURCE_DIR: ${{ github.workspace }}/source
        shell: bash
        run: |
          set -euo pipefail
          modules=()
          while IFS= read -r module; do
            modules+=("$module")
          done < <("$CLI" modules --repository "$SOURCE_DIR" --config "$CONFIG_PATH" | jq -r '.modules[]')
          for module in "${modules[@]}"; do
            directory="$SOURCE_DIR"
            [[ "$module" == "." ]] || directory="$SOURCE_DIR/$module"
            (cd "$directory" && go build ./... && go test ./... -count=1)
          done

  codeql:
    name: CodeQL ${{ matrix.language }}
    needs: preflight
    permissions:
      contents: read
      security-events: write  # CodeQL publishes results evaluated by the local gate.
    strategy:
      fail-fast: false
      matrix:
        include:
          - language: actions
            build-mode: none
            command-id: codeql/actions
          - language: go
            build-mode: manual
            command-id: codeql/go
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
      - name: Check out consumer
        uses: [%.Action "checkout"%]
        with:
          fetch-depth: 0
          persist-credentials: false
          path: source
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: gomaja/github-ci
          ref: ${{ github.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap policy CLI
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ inputs.go-version }}
          install-tools: "false"
      - name: Download applicability plan
        uses: [%.Action "download-artifact"%]
        with:
          name: github-ci-plan
          path: ${{ runner.temp }}/github-ci-plan
      - name: Initialize CodeQL
        if: ${{ matrix.language != 'go' || inputs.profile != 'repository-only' }}
        uses: [%.Action "codeql-init"%]
        with:
          languages: ${{ matrix.language }}
          build-mode: ${{ matrix.build-mode }}
          source-root: source
          queries: security-extended,security-and-quality
      - name: Build Go modules
        if: ${{ matrix.language == 'go' && inputs.profile != 'repository-only' }}
        env:
          CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          CONFIG_PATH: ${{ inputs.config-path }}
          SOURCE_DIR: ${{ github.workspace }}/source
        shell: bash
        run: |
          set -euo pipefail
          while IFS= read -r module; do
            directory="$SOURCE_DIR"
            [[ "$module" == "." ]] || directory="$SOURCE_DIR/$module"
            (cd "$directory" && go build ./...)
          done < <("$CLI" modules --repository "$SOURCE_DIR" --config "$CONFIG_PATH" | jq -r '.modules[]')
      - name: Analyze CodeQL database
        if: ${{ matrix.language != 'go' || inputs.profile != 'repository-only' }}
        uses: [%.Action "codeql-analyze"%]
        with:
          checkout_path: source
          output: ${{ runner.temp }}/github-ci-codeql
          upload: always
      - name: Record CodeQL evidence
        if: ${{ always() && (matrix.language != 'go' || inputs.profile != 'repository-only') }}
        env:
          CENTRAL_DIR: ${{ github.workspace }}/github-ci
          COMMAND_ID: ${{ matrix.command-id }}
          GITHUB_CI_CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          OUTPUT_DIR: ${{ runner.temp }}/github-ci-evidence
          PLAN_PATH: ${{ runner.temp }}/github-ci-plan/plan.json
          REPORT_PATH: ${{ runner.temp }}/github-ci-codeql/${{ matrix.language }}.sarif
          TOOL: codeql
          TOOL_VERSION: 4.37.7
        shell: bash
        run: bash "$CENTRAL_DIR/scripts/record-external.sh"
      - name: Upload CodeQL evidence
        if: ${{ always() && (matrix.language != 'go' || inputs.profile != 'repository-only') }}
        uses: [%.Action "upload-artifact"%]
        with:
          name: github-ci-codeql-${{ matrix.language }}-evidence
          path: ${{ runner.temp }}/github-ci-evidence
          if-no-files-found: error
          retention-days: 7

  dependency-review:
    name: dependency review
    needs: preflight
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: gomaja/github-ci
          ref: ${{ github.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap policy CLI
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ inputs.go-version }}
          install-tools: "false"
      - name: Download applicability plan
        uses: [%.Action "download-artifact"%]
        with:
          name: github-ci-plan
          path: ${{ runner.temp }}/github-ci-plan
      - name: Enforce dependency-review/changes
        if: ${{ github.event_name == 'pull_request' }}
        id: dependency
        uses: [%.Action "dependency-review"%]
        with:
          fail-on-severity: low
          allow-licenses: Apache-2.0, BSD-2-Clause, BSD-3-Clause, CC0-1.0, ISC, MIT, MPL-2.0, Unlicense
          retry-on-snapshot-warnings: false
      - name: Build dependency-review report
        if: ${{ always() }}
        env:
          EVENT_NAME: ${{ github.event_name }}
          OUTCOME: ${{ steps.dependency.outcome }}
          REPORT_PATH: ${{ runner.temp }}/github-ci-evidence/reports/dependency-review--dependency-review--changes.native
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$(dirname "$REPORT_PATH")"
          successful=true
          if [[ "$EVENT_NAME" == pull_request && "$OUTCOME" != success ]]; then successful=false; fi
          jq -cn --argjson successful "$successful" '{schema_version:"1",execution_successful:$successful}' >"$REPORT_PATH"
      - name: Record dependency-review evidence
        if: ${{ always() }}
        env:
          CENTRAL_DIR: ${{ github.workspace }}/github-ci
          COMMAND_ID: dependency-review/changes
          GITHUB_CI_CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          OUTPUT_DIR: ${{ runner.temp }}/github-ci-evidence
          PLAN_PATH: ${{ runner.temp }}/github-ci-plan/plan.json
          REPORT_PATH: ${{ runner.temp }}/github-ci-evidence/reports/dependency-review--dependency-review--changes.native
          TOOL: dependency-review
          TOOL_VERSION: 5.0.0
        shell: bash
        run: bash "$CENTRAL_DIR/scripts/record-external.sh"
      - name: Upload dependency-review evidence
        if: ${{ always() }}
        uses: [%.Action "upload-artifact"%]
        with:
          name: github-ci-dependency-review-evidence
          path: ${{ runner.temp }}/github-ci-evidence
          if-no-files-found: error
          retention-days: 7

  security:

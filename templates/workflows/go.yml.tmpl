# Code generated from templates/workflows/go.yml.tmpl; DO NOT EDIT.
name: reusable-go

on:
  workflow_call:
    inputs:
      profile:
        description: Fixed assurance profile.
        required: false
        default: go-strict
        type: string
      config-path:
        description: Repository-relative consumer configuration.
        required: false
        default: .github/github-ci.yaml
        type: string
      go-version:
        description: Current supported Go version.
        required: false
        default: "[[.Policy.GoVersions.Current]]"
        type: string
      previous-go-version:
        description: Previous supported Go version.
        required: false
        default: "[[.Policy.GoVersions.Previous]]"
        type: string

permissions:
  contents: read

jobs:
  policy:
    name: policy
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Harden runner
        uses: [[.Action "harden-runner"]]
        with:
          egress-policy: audit
      - name: Check out consumer
        uses: [[.Action "checkout"]]
        with:
          persist-credentials: false
      - name: Set up Go
        uses: [[.Action "setup-go"]]
        with:
          go-version: ${{ inputs.go-version }}
          cache: false
      - name: Validate toolchain
        shell: bash
        run: go version

  gate:
    name: gate
    if: ${{ always() }}
    needs: [policy]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Require policy job
        env:
          RESULT: ${{ needs.policy.result }}
        shell: bash
        run: test "$RESULT" = success

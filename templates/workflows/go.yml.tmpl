# Code generated from templates/workflows/go.yml.tmpl; DO NOT EDIT.
name: reusable-go

on:
  workflow_call:
    inputs:
      profile:
        description: Fixed assurance profile.
        required: false
        default: go-strict
        type: string
      config-path:
        description: Repository-relative consumer configuration.
        required: false
        default: .github/github-ci.yaml
        type: string
      go-version:
        description: Current supported Go version.
        required: false
        default: "[%.Policy.GoVersions.Current%]"
        type: string
      previous-go-version:
        description: Previous supported Go version.
        required: false
        default: "[%.Policy.GoVersions.Previous%]"
        type: string

permissions:
  contents: read

jobs:
  preflight:
    name: preflight
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
            files.pythonhosted.org:443
            pypi.org:443
            auth.docker.io:443
            registry-1.docker.io:443
            production.cloudfront.docker.com:443
            ghcr.io:443
            pkg-containers.githubusercontent.com:443
            api.osv.dev:443
            osv-vulnerabilities.storage.googleapis.com:443
            mirror.gcr.io:443
            toolbox-data.anchore.io:443
            grype.anchore.io:443
      - name: Check out consumer
        uses: [%.Action "checkout"%]
        with:
          persist-credentials: false
          path: source
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: gomaja/github-ci
          ref: ${{ github.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap policy CLI
        id: bootstrap
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ inputs.go-version }}
          install-tools: "false"
      - name: Build applicability plan
        env:
          CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          CONFIG_PATH: ${{ inputs.config-path }}
          EXPECTED_PROFILE: ${{ inputs.profile }}
          POLICY_PATH: ${{ github.workspace }}/github-ci/policies/tools.yaml
          SOURCE_DIR: ${{ github.workspace }}/source
          SUBJECT_SHA: ${{ github.sha }}
          PLAN_PATH: ${{ runner.temp }}/github-ci-plan/plan.json
        shell: bash
        run: |
          set -euo pipefail
          "$CLI" preflight --repository "$SOURCE_DIR" --config "$CONFIG_PATH" --profile "$EXPECTED_PROFILE" --policy "$POLICY_PATH" --subject-sha "$SUBJECT_SHA" --output "$PLAN_PATH"
      - name: Upload applicability plan
        uses: [%.Action "upload-artifact"%]
        with:
          name: github-ci-plan
          path: ${{ runner.temp }}/github-ci-plan
          if-no-files-found: error
          retention-days: 7

  formatting:
    name: formatting
    needs: preflight
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]

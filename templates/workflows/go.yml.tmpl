  evidence:
    name: evidence
    if: ${{ always() }}
    needs: [preflight, formatting, core, tests, analysis, codeql, dependency-review, security, supply-chain, repository, scorecard]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
            files.pythonhosted.org:443
            pypi.org:443
            auth.docker.io:443
            registry-1.docker.io:443
            production.cloudfront.docker.com:443
            ghcr.io:443
            pkg-containers.githubusercontent.com:443
            api.osv.dev:443
            osv-vulnerabilities.storage.googleapis.com:443
            mirror.gcr.io:443
            toolbox-data.anchore.io:443
            grype.anchore.io:443
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: gomaja/github-ci
          ref: ${{ github.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap policy CLI
        id: bootstrap
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ inputs.go-version }}
          install-tools: "false"
      - name: Download applicability plan
        if: ${{ always() }}
        uses: [%.Action "download-artifact"%]
        with:
          name: github-ci-plan
          path: ${{ runner.temp }}/github-ci-bundle/plan
      - name: Download producer evidence
        if: ${{ always() }}
        uses: [%.Action "download-artifact"%]
        with:
          pattern: github-ci-*-evidence
          path: ${{ runner.temp }}/github-ci-bundle
          merge-multiple: true
      - name: Build producer manifest
        if: ${{ always() }}
        env:
          ANALYSIS_RESULT: ${{ needs.analysis.result }}
          CODEQL_RESULT: ${{ needs.codeql.result }}
          CORE_RESULT: ${{ needs.core.result }}
          DEPENDENCY_RESULT: ${{ needs.dependency-review.result }}
          EVIDENCE_DIR: ${{ runner.temp }}/github-ci-bundle
          FORMAT_RESULT: ${{ needs.formatting.result }}
          GITHUB_CI_CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          PLAN_PATH: ${{ runner.temp }}/github-ci-bundle/plan/plan.json
          REPOSITORY_RESULT: ${{ needs.repository.result }}
          SCORECARD_RESULT: ${{ needs.scorecard.result }}
          SECURITY_RESULT: ${{ needs.security.result }}
          SUPPLY_CHAIN_RESULT: ${{ needs.supply-chain.result }}
          TEST_RESULT: ${{ needs.tests.result }}
        shell: bash
        run: bash "$GITHUB_WORKSPACE/github-ci/scripts/build-go-manifest.sh" "$EVIDENCE_DIR/manifest.json"
      - name: Upload evidence bundle
        if: ${{ always() }}
        uses: [%.Action "upload-artifact"%]
        with:
          name: github-ci-evidence
          path: ${{ runner.temp }}/github-ci-bundle
          if-no-files-found: error
          retention-days: 7

  gate:
    name: gate
    if: ${{ always() }}
    needs: [evidence, compatibility]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Harden runner
        uses: [%.Action "harden-runner"%]
        with:
          egress-policy: block
          disable-telemetry: true
          allowed-endpoints: >-
            api.github.com:443
            github.com:443
            *.github.com:443
            *.githubusercontent.com:443
            go.dev:443
            proxy.golang.org:443
            sum.golang.org:443
            storage.googleapis.com:443
            files.pythonhosted.org:443
            pypi.org:443
            auth.docker.io:443
            registry-1.docker.io:443
            production.cloudfront.docker.com:443
            ghcr.io:443
            pkg-containers.githubusercontent.com:443
            api.osv.dev:443
            osv-vulnerabilities.storage.googleapis.com:443
            mirror.gcr.io:443
            toolbox-data.anchore.io:443
            grype.anchore.io:443
      - name: Check out consumer
        uses: [%.Action "checkout"%]
        with:
          persist-credentials: false
          path: source
      - name: Check out workflow helpers
        uses: [%.Action "checkout"%]
        with:
          repository: gomaja/github-ci
          ref: ${{ github.workflow_sha }}
          persist-credentials: false
          path: github-ci
      - name: Bootstrap policy CLI
        id: bootstrap
        uses: ./github-ci/actions/bootstrap
        with:
          go-version: ${{ inputs.go-version }}
          install-tools: "false"
      - name: Download evidence bundle
        uses: [%.Action "download-artifact"%]
        with:
          name: github-ci-evidence
          path: ${{ runner.temp }}/github-ci-bundle
      - name: Evaluate aggregate gate
        env:
          CLI: ${{ runner.temp }}/github-ci-bin/github-ci
          CONFIG_PATH: ${{ inputs.config-path }}
          MANIFEST_PATH: ${{ runner.temp }}/github-ci-bundle/manifest.json
          PLAN_PATH: ${{ runner.temp }}/github-ci-bundle/plan/plan.json
          POLICY_PATH: ${{ github.workspace }}/github-ci/policies/tools.yaml
          RESULT_PATH: ${{ runner.temp }}/github-ci-result/result.json
          SOURCE_DIR: ${{ github.workspace }}/source
          STATUS_PATH: ${{ runner.temp }}/github-ci-result/status
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$(dirname "$RESULT_PATH")"
          set +e
          "$CLI" gate --repository "$SOURCE_DIR" --config "$CONFIG_PATH" --policy "$POLICY_PATH" --plan "$PLAN_PATH" --manifest "$MANIFEST_PATH" --output "$RESULT_PATH"
          status=$?
          set -e
          printf '%s\n' "$status" > "$STATUS_PATH"
      - name: Upload aggregate result
        if: ${{ always() }}
        uses: [%.Action "upload-artifact"%]
        with:
          name: github-ci-gate
          path: ${{ runner.temp }}/github-ci-result
          if-no-files-found: error
          retention-days: 7
      - name: Enforce aggregate result
        env:
          COMPATIBILITY_RESULT: ${{ needs.compatibility.result }}
          STATUS_PATH: ${{ runner.temp }}/github-ci-result/status
        shell: bash
        run: |
          set -euo pipefail
          [[ "$COMPATIBILITY_RESULT" == success ]]
          [[ -s "$STATUS_PATH" ]]
          [[ "$(cat "$STATUS_PATH")" == 0 ]]
